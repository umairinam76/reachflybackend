          user?.role ||
          "",

        permissions:
          user?.permissions ||
          [],
      }
    );
  }

  function emitWorkspaceEvent(
    workspaceId,
    eventName,
    payload
  ) {
    try {
      workspaceEmitter?.(
        workspaceId,
        eventName,
        payload
      );
    } catch {
      // Socket updates must not stop allocation.
    }
  }

  return {
    getConfig,
    saveConfig,
    status,
    getStatus: status,
    myDay,
    submitMyDay,
    runForUser,
    runWorkspace,
    runAllWorkspaces,
    runDueWorkspaces,
    startScheduler,
    reschedule: scheduleNextRun,
    stop,
  };
}

