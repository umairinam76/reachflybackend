# ==========================================================
# ReachFly production essentials
# ==========================================================
NODE_ENV=production
PORT=8787
API_HOST=0.0.0.0
APP_URL=https://www.reachflyai.com
ALLOWED_ORIGINS=https://www.reachflyai.com
DATA_DIR=/var/www/reachflybackend/data

# Generate strong values and keep them stable.
AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# ==========================================================
# Supabase / durable state
# ==========================================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# SUPABASE_SERVICE_ROLE_KEY=

# Fail safely if Supabase is empty and DATA_DIR has no live legacy store.
SUPABASE_ALLOW_EMPTY_BOOTSTRAP=false

# ==========================================================
# Lead sourcing + caller-ready audits
# ==========================================================
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
DAILY_LEAD_AUTOMATION_ENABLED=true
DAILY_LEADS_PER_CALLER=100
DAILY_LEAD_TIMEZONE=Asia/Karachi
DAILY_LEAD_ASSIGNMENT_HOUR=0
DAILY_LEAD_ASSIGNMENT_MINUTE=0
DAILY_LEAD_NICHES=dentist,restaurants,architects
DAILY_LEAD_LOCATIONS=Texas,Florida,California,New York
DAILY_LEAD_REGION_CODE=US
DAILY_LEAD_RADIUS_KM=25
DAILY_LEAD_QUALITY_LEVEL=high

# ==========================================================
# Existing manual Telnyx caller workflow
# ==========================================================
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_BASE_URL=https://api.reachflyai.com
TELNYX_FROM_NUMBERS=
# Keep this only if callers use explicit per-user credentials.
TELNYX_CALLER_CREDENTIALS_JSON={}
TELNYX_RECORD_CALLS=true

# ==========================================================
# ElevenLabs AI caller (only if this production feature is enabled)
# ==========================================================
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=
TELNYX_AI_AGENT_FROM_NUMBER=
TELNYX_AI_AGENT_TOOL_SECRET=

# Calendly is only needed for AI-agent meeting booking.
CALENDLY_ACCESS_TOKEN=
CALENDLY_EVENT_URL=https://calendly.com/umairinam76/30min
