export function createCreditBillingService({ store, workspaceService, externalSafepayHandler = null } = {}) {
  if (!store?.read || !store?.update) {
    throw new Error("createCreditBillingService requires a store exposing read() and update().");
  }

  function getWorkspaceContext(user, state = store.read()) {
    const serviceContext = workspaceService?.getContext?.(user);
    const workspaceId = clean(
      serviceContext?.workspaceId || user?.workspaceId || user?.companyId || user?.id
    );
    const workspace = serviceContext?.workspace || (state.workspaces || []).find(
      (item) => item.id === workspaceId
    ) || null;
    const role = normalizeStatus(
      serviceContext?.role || user?.workspaceRole || user?.role || "owner"
    );
    return {
      workspaceId,
      workspace,
      role,
      accountType: normalizeStatus(
        user?.accountType || user?.workspaceType || workspace?.accountType || workspace?.workspaceType
      ) || (workspace ? "company" : "individual"),
    };
  }

  function ensureStateShape(draft) {
    if (!Array.isArray(draft.creditWallets)) draft.creditWallets = [];
    if (!Array.isArray(draft.creditLedger)) draft.creditLedger = [];
    if (!Array.isArray(draft.creditReservations)) draft.creditReservations = [];
    if (!Array.isArray(draft.creditUsageEvents)) draft.creditUsageEvents = [];
    if (!Array.isArray(draft.creditPurchases)) draft.creditPurchases = [];
    if (!draft.creditRateCard || typeof draft.creditRateCard !== "object" || Array.isArray(draft.creditRateCard)) {
      draft.creditRateCard = {};
    }
    if (!Array.isArray(draft.creditPacks)) draft.creditPacks = [];
    if (!Array.isArray(draft.billingWebhookEvents)) draft.billingWebhookEvents = [];
    if (!Array.isArray(draft.billingPayments)) draft.billingPayments = [];

    // AI calling uses a separate unit wallet so the existing ReachFly
    // prepaid wallet and the launch/test-call allowance cannot be confused.
    if (!Array.isArray(draft.aiCallCreditWallets)) draft.aiCallCreditWallets = [];
    if (!Array.isArray(draft.aiCallCreditLedger)) draft.aiCallCreditLedger = [];
    if (!Array.isArray(draft.aiCallCreditUsageEvents)) draft.aiCallCreditUsageEvents = [];
    if (!Array.isArray(draft.aiCallCreditPurchases)) draft.aiCallCreditPurchases = [];

    if (!Array.isArray(draft.activity)) draft.activity = [];
  }

  function appendActivity(draft, activity) {
    ensureStateShape(draft);
    draft.activity.unshift({
      id: crypto.randomUUID(),
      createdAt: new Date().toISOString(),
      ...activity,
    });
    if (draft.activity.length > 5000) draft.activity.splice(5000);
  }

  function ensureWorkspaceWallet(workspaceId, actorId = "system") {
    const id = clean(workspaceId);
    if (!id) throw httpError(400, "Workspace is required for credit billing.", "WORKSPACE_REQUIRED");

    let output = null;
    store.update((draft) => {
      ensureStateShape(draft);
      let wallet = draft.creditWallets.find((item) => item.workspaceId === id);
      const now = new Date().toISOString();
      if (!wallet) {
        wallet = {
          id: crypto.randomUUID(),
          workspaceId: id,
          balance: 0,
          reserved: 0,
          debt: 0,
          totalGranted: 0,
          totalPurchased: 0,
          totalConsumed: 0,
          createdAt: now,
          updatedAt: now,
        };
        draft.creditWallets.push(wallet);
      }

      if (!wallet.testGrantAppliedAt && isTestGrantEnabled()) {
        wallet.balance = creditNumber(wallet.balance) + TEST_CREDIT_GRANT;
        wallet.totalGranted = creditNumber(wallet.totalGranted) + TEST_CREDIT_GRANT;
        wallet.testGrantAppliedAt = now;
        wallet.updatedAt = now;
        draft.creditLedger.unshift({
          id: crypto.randomUUID(),
          workspaceId: id,
          type: "test_grant",
          delta: TEST_CREDIT_GRANT,
          balanceAfter: wallet.balance,
          reservedAfter: creditNumber(wallet.reserved),
          actorId: clean(actorId) || "system",
          description: "One-time ReachFly test credit grant",
          createdAt: now,
        });
      }
      output = { ...wallet };
    });
    return output;
  }

  function getAiCallPolicy() {
    const configuredDuration = Number(process.env.AI_CALL_MAX_CONNECTED_SECONDS);
    const maxConnectedSeconds = Number.isFinite(configuredDuration) && configuredDuration > 0
      ? Math.round(configuredDuration)
      : null;
    const configuredPrice = Number(process.env.AI_CALL_CONNECTED_PRICE_MINOR);
    const connectedCallPriceMinor = Number.isFinite(configuredPrice) && configuredPrice > 0
      ? Math.round(configuredPrice)
      : AI_CALL_DEFAULT_PRICE_MINOR;
    const currency = clean(process.env.AI_CALL_CONNECTED_CURRENCY || AI_CALL_DEFAULT_CURRENCY).toUpperCase();

    return {
      walletType: "ai_call_credits",
      billingUnit: "connected_call",
      creditsPerConnectedCall: AI_CALL_CONNECTED_CREDIT_COST,
      signupFreeCredits: getAiCallSignupFreeCredits(),
      testCreditGrant: isAiCallTestGrantEnabled() ? AI_CALL_TEST_CREDIT_GRANT : 0,
      testCreditGrantEnabled: isAiCallTestGrantEnabled(),
      connectedCallPriceMinor,
      currency,
      maxConnectedSeconds,
      durationPolicyConfigured: Boolean(maxConnectedSeconds),
      chargingRule: "One AI call credit is consumed only after a completed call has positive duration and evidence that the prospect participated.",
    };
  }

  function getAiCallSignupFreeCredits() {
    const configured = Number(process.env.AI_CALL_SIGNUP_FREE_CREDITS);
    if (Number.isFinite(configured) && configured >= 0) {
      return Math.round(configured);
    }
    return AI_CALL_SIGNUP_FREE_CREDITS_DEFAULT;
  }

  function ensureAiCallCreditWallet(workspaceId) {
    const id = clean(workspaceId);
    if (!id) throw httpError(400, "Workspace is required for AI call credits.", "WORKSPACE_REQUIRED");

    let output = null;
    store.update((draft) => {
      ensureStateShape(draft);
      let wallet = draft.aiCallCreditWallets.find((item) => item.workspaceId === id);
      const now = new Date().toISOString();
      if (!wallet) {
        wallet = {
          id: crypto.randomUUID(),
          workspaceId: id,
          balance: 0,
          totalGranted: 0,
          totalPurchased: 0,
          totalConsumed: 0,
          debt: 0,
          testGrantAppliedAt: "",
          signupGrantAppliedAt: "",
          createdAt: now,
          updatedAt: now,
        };
        draft.aiCallCreditWallets.push(wallet);
      }
      output = { ...wallet };
    });
    return publicAiCallWallet(output);
  }

  function grantAiCallSignupCredits(workspaceId, actorId = "system") {
    const id = clean(workspaceId);
    const credits = getAiCallSignupFreeCredits();
    ensureAiCallCreditWallet(id);

    if (credits <= 0) {
      return ensureAiCallCreditWallet(id);
    }

    let output = null;
    store.update((draft) => {
      ensureStateShape(draft);
      const wallet = draft.aiCallCreditWallets.find((item) => item.workspaceId === id);
      if (!wallet) throw httpError(500, "AI call credit wallet could not be initialized.");

      if (wallet.signupGrantAppliedAt) {
        output = { ...wallet, reused: true };
        return;
      }

      const now = new Date().toISOString();
      wallet.balance = wholeCredits(wallet.balance) + credits;
      wallet.totalGranted = wholeCredits(wallet.totalGranted) + credits;
      wallet.signupGrantAppliedAt = now;
      wallet.updatedAt = now;

      draft.aiCallCreditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: id,
        type: "signup_grant",
        delta: credits,
        balanceAfter: wallet.balance,
        actorId: clean(actorId) || "system",
        description: `${credits} free AI calling credits included with signup`,
        createdAt: now,
      });
      if (draft.aiCallCreditLedger.length > 5000) draft.aiCallCreditLedger.splice(5000);

      appendActivity(draft, {
        workspaceId: id,
        actorId: clean(actorId) || "system",
        type: "ai_call_signup_credits_granted",
        title: `${credits} free AI call credits added`,
        detail: "New-workspace Voice Agent starter balance",
      });

      output = { ...wallet };
    });

    return publicAiCallWallet(output);
  }

  function grantAiCallTestCredits(workspaceId, actorId = "system") {
    if (!isAiCallTestGrantEnabled()) {
      throw httpError(
        403,
        "Free AI call credits are disabled. Purchase an AI calling credit pack to activate paid voice calling.",
        "AI_CALL_TEST_GRANT_DISABLED"
      );
    }
    const id = clean(workspaceId);
    ensureAiCallCreditWallet(id);
    let output = null;

    store.update((draft) => {
      ensureStateShape(draft);
      const wallet = draft.aiCallCreditWallets.find((item) => item.workspaceId === id);
      if (!wallet) throw httpError(500, "AI call credit wallet could not be initialized.");

      if (wallet.testGrantAppliedAt) {
        output = { ...wallet, reused: true };
        return;
      }

      const now = new Date().toISOString();
      wallet.balance = wholeCredits(wallet.balance) + AI_CALL_TEST_CREDIT_GRANT;
      wallet.totalGranted = wholeCredits(wallet.totalGranted) + AI_CALL_TEST_CREDIT_GRANT;
      wallet.testGrantAppliedAt = now;
      wallet.updatedAt = now;

      draft.aiCallCreditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: id,
        type: "test_grant",
        delta: AI_CALL_TEST_CREDIT_GRANT,
        balanceAfter: wallet.balance,
        actorId: clean(actorId) || "system",
        description: `One-time ${AI_CALL_TEST_CREDIT_GRANT}-credit AI calling test grant`,
        createdAt: now,
      });
      if (draft.aiCallCreditLedger.length > 5000) draft.aiCallCreditLedger.splice(5000);

      appendActivity(draft, {
        workspaceId: id,
        actorId: clean(actorId) || "system",
        type: "ai_call_test_credits_granted",
        title: `${AI_CALL_TEST_CREDIT_GRANT} AI call test credits granted`,
      });

      output = { ...wallet };
    });

    return publicAiCallWallet(output);
  }

  function consumeConnectedAiCall({
    workspaceId,
    callId,
    durationSeconds = 0,
    actorId = "system",
    metadata = {},
  } = {}) {
    const id = clean(workspaceId);
    const normalizedCallId = clean(callId);
    if (!id) throw httpError(400, "Workspace is required for AI call credits.", "WORKSPACE_REQUIRED");
    if (!normalizedCallId) throw httpError(400, "callId is required for AI call credit settlement.", "CALL_ID_REQUIRED");
    ensureAiCallCreditWallet(id);

    let output = null;
    store.update((draft) => {
      ensureStateShape(draft);
      const existing = draft.aiCallCreditUsageEvents.find(
        (item) => item.workspaceId === id && item.callId === normalizedCallId
      );
      if (existing) {
        output = { ...existing, reused: true };
        return;
      }

      const wallet = draft.aiCallCreditWallets.find((item) => item.workspaceId === id);
      if (!wallet) throw httpError(500, "AI call credit wallet not found.");
      if (wholeCredits(wallet.balance) < AI_CALL_CONNECTED_CREDIT_COST) {
        throw httpError(
          402,
          `Not enough AI call credits. ${AI_CALL_CONNECTED_CREDIT_COST} credit is required for a connected call; ${wholeCredits(wallet.balance)} are available.`,
          "INSUFFICIENT_AI_CALL_CREDITS",
          { requiredCredits: AI_CALL_CONNECTED_CREDIT_COST, availableCredits: wholeCredits(wallet.balance) }
        );
      }

      const policy = getAiCallPolicy();
      const duration = Math.max(0, Math.round(Number(durationSeconds) || 0));
      const now = new Date().toISOString();
      wallet.balance = wholeCredits(wallet.balance) - AI_CALL_CONNECTED_CREDIT_COST;
      wallet.totalConsumed = wholeCredits(wallet.totalConsumed) + AI_CALL_CONNECTED_CREDIT_COST;
      wallet.updatedAt = now;

      const usage = {
        id: crypto.randomUUID(),
        workspaceId: id,
        callId: normalizedCallId,
        unit: "connected_call",
        credits: AI_CALL_CONNECTED_CREDIT_COST,
        durationSeconds: duration,
        overDurationPolicy: Boolean(policy.maxConnectedSeconds && duration > policy.maxConnectedSeconds),
        metadata: sanitizeMetadata(metadata),
        actorId: clean(actorId) || "system",
        createdAt: now,
      };
      draft.aiCallCreditUsageEvents.unshift(usage);
      if (draft.aiCallCreditUsageEvents.length > 5000) draft.aiCallCreditUsageEvents.splice(5000);

      draft.aiCallCreditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: id,
        callId: normalizedCallId,
        type: "connected_call",
        delta: -AI_CALL_CONNECTED_CREDIT_COST,
        balanceAfter: wallet.balance,
        durationSeconds: duration,
        createdAt: now,
      });
      if (draft.aiCallCreditLedger.length > 5000) draft.aiCallCreditLedger.splice(5000);

      appendActivity(draft, {
        workspaceId: id,
        actorId: clean(actorId) || "system",
        type: "ai_call_credit_consumed",
        title: "AI call credit consumed",
        detail: `Connected call ${normalizedCallId}`,
      });

      output = { ...usage, balance: wallet.balance };
    });

    return output;
  }

  function getAiCallCreditPacks() {
    const policy = getAiCallPolicy();
    const configured = clean(process.env.AI_CALL_CREDIT_PACKS_JSON);
    if (configured) {
      try {
        const parsed = JSON.parse(configured);
        if (Array.isArray(parsed)) {
          return parsed
            .map((item, index) => {
              const credits = wholeCredits(item?.credits);
              const amountMinor = Math.round(Number(item?.amountMinor || 0));
              const currency = clean(item?.currency || policy.currency).toUpperCase();
              if (!credits || !Number.isFinite(amountMinor) || amountMinor <= 0 || !currency) return null;
              return {
                id: clean(item?.id) || `ai-calls-${credits}-${index + 1}`,
                label: clean(item?.label) || `${credits} AI call credits`,
                credits,
                amountMinor,
                currency,
                active: item?.active !== false,
                walletType: "ai_call_credits",
              };
            })
            .filter(Boolean);
        }
      } catch {
        // Invalid override is ignored; the server-owned default catalog remains available.
      }
    }

    const configuredOptions = String(process.env.AI_CALL_CREDIT_PACK_OPTIONS || "")
      .split(",")
      .map((value) => wholeCredits(value))
      .filter(Boolean);
    const options = configuredOptions.length ? uniqueNumbers(configuredOptions) : AI_CALL_DEFAULT_PACK_CREDITS;
    return options.map((credits) => ({
      id: `ai-calls-${credits}`,
      label: `${credits} AI call credits`,
      credits,
      amountMinor: credits * policy.connectedCallPriceMinor,
      currency: policy.currency,
      active: true,
      walletType: "ai_call_credits",
    }));
  }

  function assertAiCallCreditAvailable({ workspaceId, requiredCredits = AI_CALL_CONNECTED_CREDIT_COST } = {}) {
    const id = clean(workspaceId);
    if (!id) throw httpError(400, "Workspace is required for AI call credits.", "WORKSPACE_REQUIRED");
    const wallet = ensureAiCallCreditWallet(id);
    const required = Math.max(1, wholeCredits(requiredCredits));
    const available = wholeCredits(wallet.balance);
    if (available < required) {
      throw httpError(
        402,
        `Not enough AI call credits. ${required} credit${required === 1 ? "" : "s"} required; ${available} available.`,
        "INSUFFICIENT_AI_CALL_CREDITS",
        { requiredCredits: required, availableCredits: available }
      );
    }
    return { ok: true, requiredCredits: required, availableCredits: available, wallet };
  }

  function getAiCallCreditSnapshot(user) {
    const state = store.read();
    const ctx = getWorkspaceContext(user, state);
    if (!ctx.workspaceId) throw httpError(401, "AI calling workspace could not be resolved.");
    let wallet = ensureAiCallCreditWallet(ctx.workspaceId);
    if (
      isAiCallSignupBackfillEnabled() &&
      ctx.workspaceId !== CODESYNC_WORKSPACE_ID &&
      !wallet.signupGrantAppliedAt &&
      wholeCredits(wallet.totalGranted) === 0 &&
      wholeCredits(wallet.totalPurchased) === 0 &&
      wholeCredits(wallet.totalConsumed) === 0
    ) {
      wallet = grantAiCallSignupCredits(ctx.workspaceId, user?.id || "system");
    }
    const latest = store.read();
    const ownerLike = ["owner", "admin"].includes(ctx.role) || ctx.accountType === "individual";
    const codesyncWorkspace = ctx.workspaceId === CODESYNC_WORKSPACE_ID;
    const hasActivePurchasedNumber =
      codesyncWorkspace ||
      (latest.voicePhoneNumbers || []).some(
        (item) =>
          item.workspaceId === ctx.workspaceId &&
          normalizeStatus(item.status) === "active" &&
          (
            clean(item.orderId) ||
            item.ownershipVerified === true ||
            clean(item.source) === "existing_number"
          )
      );
    return {
      wallet,
      policy: getAiCallPolicy(),
      requiresPurchasedNumber: !codesyncWorkspace,
      hasActivePurchasedNumber,
      packs: getAiCallCreditPacks().filter((item) => item.active),
      purchases: (latest.aiCallCreditPurchases || [])
        .filter((item) => item.workspaceId === ctx.workspaceId)
        .sort(byNewest)
        .slice(0, 50)
        .map(publicAiCallPurchase),
      canPurchase: ownerLike,
      signupFreeCredits: getAiCallSignupFreeCredits(),
      signupGrantApplied: Boolean(wallet.signupGrantAppliedAt),
      testGrantAvailable: Boolean(isAiCallTestGrantEnabled() && !wallet.testGrantAppliedAt),
      usage: (latest.aiCallCreditUsageEvents || [])
        .filter((item) => item.workspaceId === ctx.workspaceId)
        .sort(byNewest)
        .slice(0, 100),
      ledger: (latest.aiCallCreditLedger || [])
        .filter((item) => item.workspaceId === ctx.workspaceId)
        .sort(byNewest)
        .slice(0, 100),
    };
  }

  function getRateCard() {
    const state = store.read();
    const overrides = state.creditRateCard && typeof state.creditRateCard === "object"
      ? state.creditRateCard
      : {};
    return DEFAULT_RATE_CARD.map((base) => {
      const saved = overrides[base.feature] || {};
      return {
        ...base,
        creditsPerUnit: positiveNumber(saved.creditsPerUnit, base.creditsPerUnit),
        billable: saved.billable === undefined ? base.billable : Boolean(saved.billable),
        label: clean(saved.label) || base.label,
        description: clean(saved.description) || base.description,
        updatedAt: saved.updatedAt || "",
      };
    });
  }

  function getRate(feature) {
    const normalized = normalizeStatus(feature);
    const rate = getRateCard().find((item) => item.feature === normalized);
    if (!rate) throw httpError(400, `Unsupported billable feature: ${normalized}.`, "UNKNOWN_BILLING_FEATURE");
    return rate;
  }

  function getCreditPacks() {
    const state = store.read();
    const savedById = new Map(
      (state.creditPacks || []).map((item) => [clean(item.id), item])
    );
    return DEFAULT_CREDIT_PACKS.map((base) => {
      const saved = savedById.get(base.id) || {};
      const amountMinorRaw = saved.amountMinor ?? base.amountMinor;
      const amountMinor = Number.isFinite(Number(amountMinorRaw)) && Number(amountMinorRaw) > 0
        ? Math.round(Number(amountMinorRaw))
        : null;
      return {
        ...base,
        ...saved,
        id: base.id,
        credits: Math.max(1, Math.round(Number(saved.credits || base.credits))),
        currency: clean(saved.currency || base.currency).toUpperCase(),
        amountMinor,
        active: Boolean(saved.active && amountMinor),
        market: clean(saved.market || base.market).toUpperCase(),
      };
    });
  }

  function reserveUsage({
    workspaceId,
    feature,
    quantity = 1,
    idempotencyKey = "",
    metadata = {},
    actorId = "system",
  } = {}) {
    const id = clean(workspaceId);
    ensureWorkspaceWallet(id, actorId);
    const rate = getRate(feature);
    const qty = positiveNumber(quantity, 1);
    const credits = rate.billable ? roundCredits(rate.creditsPerUnit * qty) : 0;
    const key = clean(idempotencyKey);
    let output = null;

    store.update((draft) => {
      ensureStateShape(draft);
      if (key) {
        const existing = draft.creditReservations.find(
          (item) => item.workspaceId === id && item.idempotencyKey === key
        );
        if (existing) {
          output = { ...existing, reused: true };
          return;
        }
      }

      const wallet = draft.creditWallets.find((item) => item.workspaceId === id);
      if (!wallet) throw httpError(500, "Credit wallet could not be initialized.");
      if (creditNumber(wallet.balance) < credits) {
        throw httpError(
          402,
          `Not enough ReachFly credits. ${credits} credits are required; ${creditNumber(wallet.balance)} are available.`,
          "INSUFFICIENT_CREDITS",
          {
            requiredCredits: credits,
            availableCredits: creditNumber(wallet.balance),
            feature: rate.feature,
          }
        );
      }

      const now = new Date().toISOString();
      wallet.balance = roundCredits(creditNumber(wallet.balance) - credits);
      wallet.reserved = roundCredits(creditNumber(wallet.reserved) + credits);
      wallet.updatedAt = now;
      const reservation = {
        id: crypto.randomUUID(),
        workspaceId: id,
        feature: rate.feature,
        unit: rate.unit,
        quantity: qty,
        creditsPerUnit: rate.creditsPerUnit,
        credits,
        status: "reserved",
        idempotencyKey: key,
        metadata: sanitizeMetadata(metadata),
        actorId: clean(actorId) || "system",
        createdAt: now,
        updatedAt: now,
      };
      draft.creditReservations.push(reservation);
      draft.creditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: id,
        type: "reserve",
        delta: -credits,
        balanceAfter: wallet.balance,
        reservedAfter: wallet.reserved,
        feature: rate.feature,
        quantity: qty,
        creditsPerUnit: rate.creditsPerUnit,
        reservationId: reservation.id,
        idempotencyKey: key,
        actorId: reservation.actorId,
        createdAt: now,
      });
      output = { ...reservation };
    });

    return output;
  }

  function commitUsage(reservationId, { actualQuantity, metadata = {} } = {}) {
    const reservationKey = clean(reservationId);
    let output = null;
    store.update((draft) => {
      ensureStateShape(draft);
      const reservation = draft.creditReservations.find((item) => item.id === reservationKey);
      if (!reservation) throw httpError(404, "Credit reservation not found.", "CREDIT_RESERVATION_NOT_FOUND");
      if (reservation.status === "committed") {
        output = { ...reservation, reused: true };
        return;
      }
      if (reservation.status !== "reserved") {
        throw httpError(409, "Credit reservation is no longer active.", "CREDIT_RESERVATION_CLOSED");
      }

      const wallet = draft.creditWallets.find((item) => item.workspaceId === reservation.workspaceId);
      if (!wallet) throw httpError(500, "Credit wallet not found.");
      const qty = actualQuantity === undefined
        ? creditNumber(reservation.quantity)
        : Math.max(0, creditNumber(actualQuantity));
      const actualCredits = roundCredits(qty * creditNumber(reservation.creditsPerUnit));
      if (actualCredits > creditNumber(reservation.credits)) {
        throw httpError(409, "Actual usage exceeds the reserved credit amount.", "CREDIT_RESERVATION_TOO_SMALL");
      }
      const unused = roundCredits(creditNumber(reservation.credits) - actualCredits);
      const now = new Date().toISOString();
      wallet.reserved = roundCredits(Math.max(0, creditNumber(wallet.reserved) - creditNumber(reservation.credits)));
      if (unused > 0) wallet.balance = roundCredits(creditNumber(wallet.balance) + unused);
      wallet.totalConsumed = roundCredits(creditNumber(wallet.totalConsumed) + actualCredits);
      wallet.updatedAt = now;
      reservation.status = "committed";
      reservation.actualQuantity = qty;
      reservation.actualCredits = actualCredits;
      reservation.releasedCredits = unused;
      reservation.metadata = {
        ...reservation.metadata,
        ...sanitizeMetadata(metadata),
      };
      reservation.updatedAt = now;
      reservation.committedAt = now;

      const usage = {
        id: crypto.randomUUID(),
        workspaceId: reservation.workspaceId,
        feature: reservation.feature,
        unit: reservation.unit,
        quantity: qty,
        creditsPerUnit: reservation.creditsPerUnit,
        credits: actualCredits,
        reservationId: reservation.id,
        idempotencyKey: reservation.idempotencyKey,
        metadata: reservation.metadata,
        createdAt: now,
      };
      draft.creditUsageEvents.unshift(usage);
      draft.creditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: reservation.workspaceId,
        type: "usage",
        delta: unused,
        balanceAfter: wallet.balance,
        reservedAfter: wallet.reserved,
        feature: reservation.feature,
        quantity: qty,
        creditsPerUnit: reservation.creditsPerUnit,
        creditsConsumed: actualCredits,
        reservationId: reservation.id,
        idempotencyKey: reservation.idempotencyKey,
        actorId: reservation.actorId,
        createdAt: now,
      });
      output = { ...reservation, usage };
    });
    return output;
  }

  function releaseUsage(reservationId, reason = "released") {
    const reservationKey = clean(reservationId);
    let output = null;
    store.update((draft) => {
      ensureStateShape(draft);
      const reservation = draft.creditReservations.find((item) => item.id === reservationKey);
      if (!reservation) return;
      if (reservation.status !== "reserved") {
        output = { ...reservation, reused: true };
        return;
      }
      const wallet = draft.creditWallets.find((item) => item.workspaceId === reservation.workspaceId);
      if (!wallet) return;
      const now = new Date().toISOString();
      wallet.balance = roundCredits(creditNumber(wallet.balance) + creditNumber(reservation.credits));
      wallet.reserved = roundCredits(Math.max(0, creditNumber(wallet.reserved) - creditNumber(reservation.credits)));
      wallet.updatedAt = now;
      reservation.status = "released";
      reservation.releaseReason = clean(reason).slice(0, 500);
      reservation.updatedAt = now;
      reservation.releasedAt = now;
      draft.creditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: reservation.workspaceId,
        type: "release",
        delta: creditNumber(reservation.credits),
        balanceAfter: wallet.balance,
        reservedAfter: wallet.reserved,
        feature: reservation.feature,
        reservationId: reservation.id,
        idempotencyKey: reservation.idempotencyKey,
        description: reservation.releaseReason,
        actorId: reservation.actorId,
        createdAt: now,
      });
      output = { ...reservation };
    });
    return output;
  }

  function consumeUsage(input = {}) {
    const reservation = reserveUsage(input);
    return commitUsage(reservation.id, {
      actualQuantity: input.quantity,
      metadata: input.metadata,
    });
  }

