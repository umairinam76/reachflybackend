  async function handleSafepayWebhook({ rawBody = "", headers = {}, body = {} } = {}) {
    const webhookSecret = requireEnv("SAFEPAY_WEBHOOK_SECRET");
    const signature = clean(headers["x-sfpy-signature"] || headers["X-SFPY-SIGNATURE"]);
    if (!signature) throw httpError(400, "Missing Safepay webhook signature.", "SAFEPAY_SIGNATURE_MISSING");
    const payloadText = typeof rawBody === "string" && rawBody ? rawBody : JSON.stringify(body || {});
    const calculated = crypto
      .createHmac("sha512", webhookSecret)
      .update(Buffer.from(payloadText))
      .digest("hex");
    if (!safeEqualHex(calculated, signature)) {
      throw httpError(400, "Invalid Safepay webhook signature.", "SAFEPAY_SIGNATURE_INVALID");
    }

    const event = body && typeof body === "object" ? body : JSON.parse(payloadText || "{}");
    const eventId = clean(event.token || event.id);
    const eventType = normalizeEventType(event.type);
    if (!eventId || !eventType) {
      throw httpError(400, "Safepay webhook is missing event identity.", "SAFEPAY_EVENT_INVALID");
    }

    const state = store.read();
    const existing = (state.billingWebhookEvents || []).find(
      (item) => item.provider === "safepay" && item.eventId === eventId
    );
    if (existing?.processed) {
      return { ok: true, duplicate: true, eventId, eventType };
    }

    const receivedAt = new Date().toISOString();
    store.update((draft) => {
      ensureStateShape(draft);
      const duplicate = draft.billingWebhookEvents.find(
        (item) => item.provider === "safepay" && item.eventId === eventId
      );
      if (!duplicate) {
        draft.billingWebhookEvents.unshift({
          id: crypto.randomUUID(),
          provider: "safepay",
          eventId,
          eventType,
          tracker: clean(event?.data?.tracker),
          processed: false,
          receivedAt,
          createdAt: receivedAt,
        });
      }
    });

    let processingResult = { matched: false };
    if (eventType === "payment.succeeded") {
      processingResult = applySuccessfulPurchase(event);
    } else if (eventType === "payment.failed") {
      processingResult = applyFailedPurchase(event);
    } else if (eventType === "payment.refunded") {
      processingResult = applyRefundedPurchase(event);
    }

    if (!processingResult?.matched && typeof externalSafepayHandler === "function") {
      const externalResult = await externalSafepayHandler({
        event,
        eventId,
        eventType,
      });
      if (externalResult?.matched) processingResult = externalResult;
    }

    store.update((draft) => {
      ensureStateShape(draft);
      const target = draft.billingWebhookEvents.find(
        (item) => item.provider === "safepay" && item.eventId === eventId
      );
      if (!target) return;
      target.processed = true;
      target.processedAt = new Date().toISOString();
      target.result = processingResult;
    });

    return {
      ok: true,
      eventId,
      eventType,
      ...processingResult,
    };
  }

  function findAiCallPurchase(draft, event) {
    const data = event?.data || {};
    const metadata = data.metadata || {};
    const tracker = clean(data.tracker);
    const purchaseId = clean(metadata.purchase_id || metadata.purchaseId);
    return (draft.aiCallCreditPurchases || []).find(
      (item) => (purchaseId && item.id === purchaseId) || (tracker && item.providerTracker === tracker)
    );
  }

  function applySuccessfulAiCallPurchase(event) {
    const data = event?.data || {};
    const tracker = clean(data.tracker);
    let output = { matched: false, tracker, walletType: "ai_call_credits" };
    store.update((draft) => {
      ensureStateShape(draft);
      const purchase = findAiCallPurchase(draft, event);
      if (!purchase) return;
      output.matched = true;
      output.purchaseId = purchase.id;
      if (purchase.status === "succeeded" && purchase.creditsGrantedAt) {
        output.duplicatePurchase = true;
        return;
      }
      if (Number(data.amount) && Number(data.amount) !== Number(purchase.amountMinor)) {
        throw httpError(409, "Safepay amount does not match the ReachFly AI call-credit purchase.", "SAFEPAY_AMOUNT_MISMATCH");
      }
      if (clean(data.currency).toUpperCase() && clean(data.currency).toUpperCase() !== clean(purchase.currency).toUpperCase()) {
        throw httpError(409, "Safepay currency does not match the ReachFly AI call-credit purchase.", "SAFEPAY_CURRENCY_MISMATCH");
      }

      let wallet = draft.aiCallCreditWallets.find((item) => item.workspaceId === purchase.workspaceId);
      const now = new Date().toISOString();
      if (!wallet) {
        wallet = {
          id: crypto.randomUUID(),
          workspaceId: purchase.workspaceId,
          balance: 0,
          debt: 0,
          totalGranted: 0,
          totalPurchased: 0,
          totalConsumed: 0,
          testGrantAppliedAt: "",
          createdAt: now,
          updatedAt: now,
        };
        draft.aiCallCreditWallets.push(wallet);
      }
      const purchasedCredits = wholeCredits(purchase.credits);
      const debt = wholeCredits(wallet.debt);
      const debtPaid = Math.min(debt, purchasedCredits);
      const availableGrant = purchasedCredits - debtPaid;
      wallet.debt = debt - debtPaid;
      wallet.balance = wholeCredits(wallet.balance) + availableGrant;
      wallet.totalPurchased = wholeCredits(wallet.totalPurchased) + purchasedCredits;
      wallet.updatedAt = now;

      purchase.status = "succeeded";
      purchase.paidAt = now;
      purchase.creditsGrantedAt = now;
      purchase.providerEventId = clean(event.token || event.id);
      purchase.providerAmountMinor = Number(data.amount || purchase.amountMinor);
      purchase.providerCurrency = clean(data.currency || purchase.currency).toUpperCase();
      purchase.updatedAt = now;

      draft.aiCallCreditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: purchase.workspaceId,
        purchaseId: purchase.id,
        type: "purchase",
        delta: availableGrant,
        balanceAfter: wallet.balance,
        provider: "safepay",
        providerTracker: tracker,
        description: `${purchasedCredits} AI call credits purchased${debtPaid ? `; ${debtPaid} applied to AI call-credit debt` : ""}`,
        createdAt: now,
      });
      if (draft.aiCallCreditLedger.length > 5000) draft.aiCallCreditLedger.splice(5000);

      draft.billingPayments.unshift({
        id: crypto.randomUUID(),
        workspaceId: purchase.workspaceId,
        userId: purchase.userId,
        provider: "safepay",
        providerTransactionId: tracker,
        purchaseId: purchase.id,
        productType: "ai_call_credits",
        amountCents: Number(purchase.amountMinor || 0),
        amountMinor: Number(purchase.amountMinor || 0),
        currency: purchase.currency,
        status: "succeeded",
        paidAt: now,
        createdAt: now,
      });
      appendActivity(draft, {
        workspaceId: purchase.workspaceId,
        actorId: purchase.userId,
        type: "ai_call_credit_purchase_succeeded",
        title: `${purchasedCredits} AI call credits purchased`,
        detail: `${purchase.currency} ${Number(purchase.amountMinor || 0) / 100}`,
        createdAt: now,
      });
      output.creditsGranted = availableGrant;
      output.balance = wallet.balance;
    });
    return output;
  }

  function applyFailedAiCallPurchase(event) {
    const data = event?.data || {};
    const tracker = clean(data.tracker);
    let output = { matched: false, tracker, walletType: "ai_call_credits" };
    store.update((draft) => {
      ensureStateShape(draft);
      const purchase = findAiCallPurchase(draft, event);
      if (!purchase) return;
      output.matched = true;
      output.purchaseId = purchase.id;
      if (purchase.status !== "succeeded") purchase.status = "failed";
      purchase.error = clean(data.message || data.category || "Safepay payment failed.").slice(0, 1000);
      purchase.updatedAt = new Date().toISOString();
    });
    return output;
  }

  function applyRefundedAiCallPurchase(event) {
    const data = event?.data || {};
    const tracker = clean(data.tracker);
    let output = { matched: false, tracker, walletType: "ai_call_credits" };
    store.update((draft) => {
      ensureStateShape(draft);
      const purchase = findAiCallPurchase(draft, event);
      if (!purchase) return;
      output.matched = true;
      output.purchaseId = purchase.id;
      if (purchase.refundProcessedAt) {
        output.duplicateRefund = true;
        return;
      }
      const wallet = draft.aiCallCreditWallets.find((item) => item.workspaceId === purchase.workspaceId);
      if (!wallet) return;
      const now = new Date().toISOString();
      const refundableCredits = wholeCredits(purchase.credits);
      const removed = Math.min(wholeCredits(wallet.balance), refundableCredits);
      const debt = refundableCredits - removed;
      wallet.balance = wholeCredits(wallet.balance) - removed;
      wallet.debt = wholeCredits(wallet.debt) + debt;
      wallet.updatedAt = now;
      purchase.status = "refunded";
      purchase.refundProcessedAt = now;
      purchase.refundAmountMinor = Number(data.refund_amount || 0);
      purchase.updatedAt = now;
      draft.aiCallCreditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: purchase.workspaceId,
        purchaseId: purchase.id,
        type: "refund",
        delta: -removed,
        balanceAfter: wallet.balance,
        provider: "safepay",
        providerTracker: tracker,
        description: debt
          ? `${removed} AI call credits removed; ${debt} recorded as AI call-credit debt.`
          : `${removed} AI call credits removed after refund.`,
        createdAt: now,
      });
      if (draft.aiCallCreditLedger.length > 5000) draft.aiCallCreditLedger.splice(5000);
      output.creditsRemoved = removed;
      output.creditDebt = wallet.debt;
    });
    return output;
  }

  function applySuccessfulPurchase(event) {
    const aiCallResult = applySuccessfulAiCallPurchase(event);
    if (aiCallResult.matched) return aiCallResult;
    const data = event?.data || {};
    const tracker = clean(data.tracker);
    const metadata = data.metadata || {};
    const purchaseId = clean(metadata.purchase_id || metadata.purchaseId);
    let output = { matched: false, tracker };

    store.update((draft) => {
      ensureStateShape(draft);
      const purchase = draft.creditPurchases.find(
        (item) => (purchaseId && item.id === purchaseId) || (tracker && item.providerTracker === tracker)
      );
      if (!purchase) return;
      output.matched = true;
      output.purchaseId = purchase.id;
      if (purchase.status === "succeeded" && purchase.creditsGrantedAt) {
        output.duplicatePurchase = true;
        return;
      }
      if (Number(data.amount) && Number(data.amount) !== Number(purchase.amountMinor)) {
        throw httpError(409, "Safepay amount does not match the ReachFly credit purchase.", "SAFEPAY_AMOUNT_MISMATCH");
      }
      if (clean(data.currency).toUpperCase() && clean(data.currency).toUpperCase() !== clean(purchase.currency).toUpperCase()) {
        throw httpError(409, "Safepay currency does not match the ReachFly credit purchase.", "SAFEPAY_CURRENCY_MISMATCH");
      }

      let wallet = draft.creditWallets.find((item) => item.workspaceId === purchase.workspaceId);
      const now = new Date().toISOString();
      if (!wallet) {
        wallet = {
          id: crypto.randomUUID(),
          workspaceId: purchase.workspaceId,
          balance: 0,
          reserved: 0,
          debt: 0,
          totalGranted: 0,
          totalPurchased: 0,
          totalConsumed: 0,
          createdAt: now,
          updatedAt: now,
        };
        draft.creditWallets.push(wallet);
      }
      const debt = creditNumber(wallet.debt);
      const purchasedCredits = creditNumber(purchase.credits);
      const debtPaid = Math.min(debt, purchasedCredits);
      const availableGrant = roundCredits(purchasedCredits - debtPaid);
      wallet.debt = roundCredits(debt - debtPaid);
      wallet.balance = roundCredits(creditNumber(wallet.balance) + availableGrant);
      wallet.totalPurchased = roundCredits(creditNumber(wallet.totalPurchased) + purchasedCredits);
      wallet.updatedAt = now;
      purchase.status = "succeeded";
      purchase.paidAt = now;
      purchase.creditsGrantedAt = now;
      purchase.providerEventId = clean(event.token || event.id);
      purchase.providerAmountMinor = Number(data.amount || purchase.amountMinor);
      purchase.providerCurrency = clean(data.currency || purchase.currency).toUpperCase();
      purchase.updatedAt = now;

      draft.creditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: purchase.workspaceId,
        type: "purchase",
        delta: availableGrant,
        balanceAfter: wallet.balance,
        reservedAfter: creditNumber(wallet.reserved),
        purchaseId: purchase.id,
        provider: "safepay",
        providerTracker: tracker,
        description: `${purchasedCredits} credits purchased${debtPaid ? `; ${debtPaid} applied to credit debt` : ""}`,
        createdAt: now,
      });
      draft.billingPayments.unshift({
        id: crypto.randomUUID(),
        workspaceId: purchase.workspaceId,
        userId: purchase.userId,
        provider: "safepay",
        providerTransactionId: tracker,
        purchaseId: purchase.id,
        amountCents: Number(purchase.amountMinor || 0),
        amountMinor: Number(purchase.amountMinor || 0),
        currency: purchase.currency,
        status: "succeeded",
        paidAt: now,
        createdAt: now,
      });
      appendActivity(draft, {
        workspaceId: purchase.workspaceId,
        actorId: purchase.userId,
        type: "credit_purchase_succeeded",
        title: `${purchasedCredits} ReachFly credits purchased`,
        detail: `${purchase.currency} ${Number(purchase.amountMinor || 0) / 100}`,
        createdAt: now,
      });
      output.creditsGranted = availableGrant;
      output.balance = wallet.balance;
    });

    return output;
  }

  function applyFailedPurchase(event) {
    const aiCallResult = applyFailedAiCallPurchase(event);
    if (aiCallResult.matched) return aiCallResult;
    const data = event?.data || {};
    const tracker = clean(data.tracker);
    let output = { matched: false, tracker };
    store.update((draft) => {
      ensureStateShape(draft);
      const purchase = draft.creditPurchases.find((item) => item.providerTracker === tracker);
      if (!purchase) return;
      output.matched = true;
      output.purchaseId = purchase.id;
      if (purchase.status !== "succeeded") purchase.status = "failed";
      purchase.error = clean(data.message || data.category || "Safepay payment failed.").slice(0, 1000);
      purchase.updatedAt = new Date().toISOString();
    });
    return output;
  }

  function applyRefundedPurchase(event) {
    const aiCallResult = applyRefundedAiCallPurchase(event);
    if (aiCallResult.matched) return aiCallResult;
    const data = event?.data || {};
    const tracker = clean(data.tracker);
    let output = { matched: false, tracker };
    store.update((draft) => {
      ensureStateShape(draft);
      const purchase = draft.creditPurchases.find((item) => item.providerTracker === tracker);
      if (!purchase) return;
      output.matched = true;
      output.purchaseId = purchase.id;
      if (purchase.refundProcessedAt) {
        output.duplicateRefund = true;
        return;
      }
      const wallet = draft.creditWallets.find((item) => item.workspaceId === purchase.workspaceId);
      if (!wallet) return;
      const now = new Date().toISOString();
      const refundableCredits = creditNumber(purchase.credits);
      const removed = Math.min(creditNumber(wallet.balance), refundableCredits);
      const debt = roundCredits(refundableCredits - removed);
      wallet.balance = roundCredits(creditNumber(wallet.balance) - removed);
      wallet.debt = roundCredits(creditNumber(wallet.debt) + debt);
      wallet.updatedAt = now;
      purchase.status = "refunded";
      purchase.refundProcessedAt = now;
      purchase.refundAmountMinor = Number(data.refund_amount || 0);
      purchase.updatedAt = now;
      draft.creditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: purchase.workspaceId,
        type: "refund",
        delta: -removed,
        balanceAfter: wallet.balance,
        reservedAfter: creditNumber(wallet.reserved),
        purchaseId: purchase.id,
        provider: "safepay",
        providerTracker: tracker,
        description: debt
          ? `${removed} credits removed; ${debt} credits recorded as debt because they had already been consumed.`
          : `${removed} purchased credits removed after refund.`,
        createdAt: now,
      });
      appendActivity(draft, {
        workspaceId: purchase.workspaceId,
        actorId: purchase.userId,
        type: "credit_purchase_refunded",
        title: `Safepay credit purchase refunded`,
        detail: `${removed} available credits removed${debt ? `; ${debt} credit debt recorded` : ""}.`,
        createdAt: now,
      });
      output.creditsRemoved = removed;
      output.creditDebt = wallet.debt;
    });
    return output;
  }

  function updateRate(feature, input = {}, actorId = "system") {
    const normalized = normalizeStatus(feature);
    const base = DEFAULT_RATE_CARD.find((item) => item.feature === normalized);
    if (!base) throw httpError(404, "Credit rate not found.");
    const value = Number(input.creditsPerUnit);
    if (!Number.isFinite(value) || value < 0 || value > 100000) {
      throw httpError(400, "creditsPerUnit must be a non-negative number.");
    }
    const now = new Date().toISOString();
    store.update((draft) => {
      ensureStateShape(draft);
      draft.creditRateCard[normalized] = {
        ...(draft.creditRateCard[normalized] || {}),
        creditsPerUnit: roundCredits(value),
        billable: input.billable === undefined
          ? draft.creditRateCard[normalized]?.billable ?? base.billable
          : Boolean(input.billable),
        updatedBy: clean(actorId),
        updatedAt: now,
      };
      appendActivity(draft, {
        workspaceId: CODESYNC_WORKSPACE_ID,
        actorId: clean(actorId),
        type: "credit_rate_updated",
        title: `${base.label} credit rate updated to ${roundCredits(value)} credits per ${base.unit}`,
        createdAt: now,
      });
    });
    return getRate(normalized);
  }

  function updatePack(packId, input = {}, actorId = "system") {
    const id = clean(packId);
    const base = DEFAULT_CREDIT_PACKS.find((item) => item.id === id);
    if (!base) throw httpError(404, "Credit pack not found.");
    const amountMinor = Number(input.amountMinor);
    const credits = Number(input.credits ?? base.credits);
    if (!Number.isFinite(credits) || credits <= 0) throw httpError(400, "Pack credits must be greater than zero.");
    if (input.active === true && (!Number.isFinite(amountMinor) || amountMinor <= 0)) {
      throw httpError(400, "Configure a positive Safepay amount before activating a credit pack.");
    }
    const now = new Date().toISOString();
    store.update((draft) => {
      ensureStateShape(draft);
      let target = draft.creditPacks.find((item) => item.id === id);
      if (!target) {
        target = { id };
        draft.creditPacks.push(target);
      }
      Object.assign(target, {
        credits: Math.round(credits),
        amountMinor: Number.isFinite(amountMinor) && amountMinor > 0 ? Math.round(amountMinor) : null,
        currency: clean(input.currency || base.currency).toUpperCase(),
        market: clean(input.market || base.market).toUpperCase(),
        active: Boolean(input.active),
        updatedBy: clean(actorId),
        updatedAt: now,
      });
      appendActivity(draft, {
        workspaceId: CODESYNC_WORKSPACE_ID,
        actorId: clean(actorId),
        type: "credit_pack_updated",
        title: `${id} credit pack ${target.active ? "activated/updated" : "updated/disabled"}`,
        createdAt: now,
      });
    });
    return getCreditPacks().find((item) => item.id === id);
  }

  function adjustWorkspaceCredits(workspaceId, input = {}, actorId = "system") {
    const id = clean(workspaceId);
    ensureWorkspaceWallet(id, actorId);
    const delta = Number(input.delta);
    if (!Number.isFinite(delta) || delta === 0 || Math.abs(delta) > 1_000_000) {
      throw httpError(400, "Credit adjustment delta must be a non-zero number within the allowed range.");
    }
    const reason = clean(input.reason);
    if (!reason) throw httpError(400, "A reason is required for manual credit adjustments.");
    let output = null;
    store.update((draft) => {
      ensureStateShape(draft);
      const wallet = draft.creditWallets.find((item) => item.workspaceId === id);
      if (!wallet) throw httpError(404, "Credit wallet not found.");
      if (delta < 0 && creditNumber(wallet.balance) + delta < 0) {
        throw httpError(409, "This adjustment would make the available credit balance negative.");
      }
      const now = new Date().toISOString();
      wallet.balance = roundCredits(creditNumber(wallet.balance) + delta);
      if (delta > 0) wallet.totalGranted = roundCredits(creditNumber(wallet.totalGranted) + delta);
      wallet.updatedAt = now;
      draft.creditLedger.unshift({
        id: crypto.randomUUID(),
        workspaceId: id,
        type: "admin_adjustment",
        delta: roundCredits(delta),
        balanceAfter: wallet.balance,
        reservedAfter: creditNumber(wallet.reserved),
        actorId: clean(actorId),
        description: reason.slice(0, 1000),
        createdAt: now,
      });
      appendActivity(draft, {
        workspaceId: CODESYNC_WORKSPACE_ID,
        actorId: clean(actorId),
        targetWorkspaceId: id,
        type: "credit_balance_adjusted",
        title: `Workspace ${id} credits adjusted by ${roundCredits(delta)}`,
        detail: reason.slice(0, 1000),
        createdAt: now,
      });
      output = { ...wallet };
    });
    return publicWallet(output);
  }

  function getAdminSnapshot(accounts = []) {
    const latest = store.read();
    const accountByWorkspace = new Map(accounts.map((item) => [item.workspaceId, item]));
    const storedWallets = new Map(
      (latest.creditWallets || []).map((wallet) => [wallet.workspaceId, wallet])
    );
    const wallets = accounts
      .filter((account) => account.workspaceId)
      .map((account) => {
        const wallet = storedWallets.get(account.workspaceId);
        return {
          ...publicWallet(wallet || { workspaceId: account.workspaceId }),
          accountName: account.displayName || account.workspaceId,
          testGrantPending: Boolean(!wallet?.testGrantAppliedAt && isTestGrantEnabled()),
        };
      });
    const purchases = (latest.creditPurchases || []).map((purchase) => ({
      ...publicPurchase(purchase),
      accountName: accountByWorkspace.get(purchase.workspaceId)?.displayName || purchase.workspaceId,
    }));
    const usage = (latest.creditUsageEvents || []).map((item) => ({
      ...publicUsage(item),
      accountName: accountByWorkspace.get(item.workspaceId)?.displayName || item.workspaceId,
    }));
    const revenueByCurrency = {};
    for (const purchase of purchases.filter((item) => item.status === "succeeded")) {
      const currency = clean(purchase.currency || "USD").toUpperCase();
      revenueByCurrency[currency] = (revenueByCurrency[currency] || 0) + Number(purchase.amountMinor || 0);
    }
    const usageByFeature = new Map();
    for (const item of usage) {
      const current = usageByFeature.get(item.feature) || { feature: item.feature, quantity: 0, credits: 0 };
      current.quantity += Number(item.quantity || 0);
      current.credits += Number(item.credits || 0);
      usageByFeature.set(item.feature, current);
    }
    const aiCallWallets = (latest.aiCallCreditWallets || []).map(publicAiCallWallet);
    const aiCallUsage = (latest.aiCallCreditUsageEvents || []).map((item) => ({ ...item }));

    return {
      freeTestCredits: isTestGrantEnabled() ? TEST_CREDIT_GRANT : 0,
      aiCallTestCredits: AI_CALL_TEST_CREDIT_GRANT,
      aiCallSignupFreeCredits: getAiCallSignupFreeCredits(),
      aiCallPolicy: getAiCallPolicy(),
      aiCallWallets,
      aiCallUsage: aiCallUsage.sort(byNewest).slice(0, 500),
      totalAiCallCreditsAvailable: aiCallWallets.reduce((sum, item) => sum + wholeCredits(item.balance), 0),
      totalAiCallCreditsConsumed: aiCallWallets.reduce((sum, item) => sum + wholeCredits(item.totalConsumed), 0),
      testGrantEnabled: isTestGrantEnabled(),
      wallets: wallets.sort((a, b) => b.balance - a.balance),
      purchases: purchases.sort(byNewest).slice(0, 300),
      usage: usage.sort(byNewest).slice(0, 500),
      rateCard: getRateCard(),
      packs: getCreditPacks(),
      revenueByCurrency,
      totalAvailableCredits: roundCredits(wallets.reduce((sum, item) => sum + Number(item.balance || 0), 0)),
      totalReservedCredits: roundCredits(wallets.reduce((sum, item) => sum + Number(item.reserved || 0), 0)),
      totalPurchasedCredits: roundCredits(wallets.reduce((sum, item) => sum + Number(item.totalPurchased || 0), 0)),
      totalConsumedCredits: roundCredits(wallets.reduce((sum, item) => sum + Number(item.totalConsumed || 0), 0)),
      walletsWithDebt: wallets.filter((item) => Number(item.debt || 0) > 0).length,
      successfulPurchases: purchases.filter((item) => item.status === "succeeded").length,
      usageByFeature: [...usageByFeature.values()].sort((a, b) => b.credits - a.credits),
      safepayConfigured: Boolean(clean(process.env.SAFEPAY_SECRET_KEY) && clean(process.env.SAFEPAY_PUBLIC_KEY)),
      environment: getSafepayEnvironment(),
    };
  }

  return {
    getBillingDashboard,
    getAiCallCreditSnapshot,
    getAiCallCreditPacks,
    getAiCallSignupFreeCredits,
    ensureAiCallCreditWallet,
    grantAiCallSignupCredits,
    assertAiCallCreditAvailable,
    grantAiCallTestCredits,
    consumeConnectedAiCall,
    createCreditCheckout,
    createAiCallCreditCheckout,
    handleSafepayWebhook,
    ensureWorkspaceWallet,
    reserveUsage,
    commitUsage,
    releaseUsage,
    consumeUsage,
    getRateCard,
    getRate,
    getCreditPacks,
    updateRate,
    updatePack,
    adjustWorkspaceCredits,
    getAdminSnapshot,
  };
}

async function getSafepayClient() {
  const secretKey = requireEnv("SAFEPAY_SECRET_KEY");
  const host = clean(process.env.SAFEPAY_HOST) || (
    getSafepayEnvironment() === "production"
      ? "https://api.getsafepay.com"
      : "https://sandbox.api.getsafepay.com"
  );
  let imported;
  try {
    imported = await import("@sfpy/node-core");
  } catch (error) {
    throw httpError(
      503,
      "Safepay SDK is not installed. Run npm install @sfpy/node-core on the ReachFly API.",
      "SAFEPAY_SDK_MISSING"
    );
  }
  const factory = imported?.default || imported;
  if (typeof factory !== "function") {
    throw httpError(503, "Safepay SDK could not be initialized.", "SAFEPAY_SDK_INVALID");
  }
  return factory(secretKey, { authType: "secret", host });
}

function requireEnv(name) {
  const value = clean(process.env[name]);
  if (!value) throw httpError(503, `${name} is required for Safepay billing.`, "BILLING_NOT_CONFIGURED");
  return value;
}


function isTestGrantEnabled() {
  const configured = String(process.env.CREDIT_TEST_GRANT_ENABLED ?? "").trim().toLowerCase();
  if (configured) return ["1", "true", "yes", "on"].includes(configured);
  return getSafepayEnvironment() !== "production";
}

function isAiCallSignupBackfillEnabled() {
  const configured = String(
    process.env.AI_CALL_SIGNUP_FREE_CREDITS_BACKFILL ?? ""
  ).trim().toLowerCase();
  return ["1", "true", "yes", "on"].includes(configured);
}

function isAiCallTestGrantEnabled() {
  const configured = String(process.env.AI_CALL_TEST_GRANT_ENABLED ?? "").trim().toLowerCase();
  return ["1", "true", "yes", "on"].includes(configured);
}

function getSafepayEnvironment() {
  return normalizeStatus(process.env.SAFEPAY_ENV || DEFAULT_ENVIRONMENT) === "production"
    ? "production"
    : "sandbox";
}

function normalizeCheckoutReturnPath(value, fallback = "/app/billing") {
  const raw = clean(value);
  if (!raw) return fallback;
  if (!raw.startsWith("/") || raw.startsWith("//")) return fallback;
  if (/^[\s\u0000-\u001f]*javascript:/i.test(raw)) return fallback;
  return raw.slice(0, 500);
}

function buildCheckoutReturnUrl(path, params = {}) {
  const base = new URL(normalizeCheckoutReturnPath(path), `${getAppUrl()}/`);
  for (const [key, value] of Object.entries(params)) {
    if (value !== undefined && value !== null && String(value) !== "") {
      base.searchParams.set(key, String(value));
    }
  }
  return base.toString();
}

function getAppUrl() {
  return String(process.env.APP_URL || "https://www.reachflyai.com").trim().replace(/\/+$/, "");
}

function safeEqualHex(left, right) {
  const a = Buffer.from(String(left || "").trim().toLowerCase(), "utf8");
  const b = Buffer.from(String(right || "").trim().toLowerCase(), "utf8");
  return a.length === b.length && a.length > 0 && crypto.timingSafeEqual(a, b);
}

function normalizeEventType(value) {
  return String(value || "").trim().toLowerCase();
}

function publicWallet(wallet = {}) {
  return {
    id: wallet.id || "",
    workspaceId: wallet.workspaceId || "",
    balance: creditNumber(wallet.balance),
    reserved: creditNumber(wallet.reserved),
    debt: creditNumber(wallet.debt),
    totalGranted: creditNumber(wallet.totalGranted),
    totalPurchased: creditNumber(wallet.totalPurchased),
    totalConsumed: creditNumber(wallet.totalConsumed),
    testGrantAppliedAt: wallet.testGrantAppliedAt || "",
    updatedAt: wallet.updatedAt || "",
  };
}

function publicAiCallWallet(wallet = {}) {
  return {
    id: wallet.id || "",
    workspaceId: wallet.workspaceId || "",
    balance: wholeCredits(wallet.balance),
    totalGranted: wholeCredits(wallet.totalGranted),
    totalPurchased: wholeCredits(wallet.totalPurchased),
    totalConsumed: wholeCredits(wallet.totalConsumed),
    debt: wholeCredits(wallet.debt),
    testGrantAppliedAt: wallet.testGrantAppliedAt || "",
    signupGrantAppliedAt: wallet.signupGrantAppliedAt || "",
    createdAt: wallet.createdAt || "",
    updatedAt: wallet.updatedAt || "",
  };
}

function publicPurchase(item = {}) {
  return {
    id: item.id || "",
    workspaceId: item.workspaceId || "",
    packId: item.packId || "",
    credits: creditNumber(item.credits),
    amountMinor: Number(item.amountMinor || 0),
    currency: clean(item.currency || "USD").toUpperCase(),
    status: normalizeStatus(item.status || "unknown"),
    provider: item.provider || "safepay",
    providerTracker: item.providerTracker || "",
    createdAt: item.createdAt || "",
    paidAt: item.paidAt || "",
    error: item.error || "",
  };
}

function publicAiCallPurchase(item = {}) {
  return {
    id: item.id || "",
    workspaceId: item.workspaceId || "",
    packId: item.packId || "",
    credits: wholeCredits(item.credits),
    amountMinor: Number(item.amountMinor || 0),
    currency: clean(item.currency || AI_CALL_DEFAULT_CURRENCY).toUpperCase(),
    status: normalizeStatus(item.status || "unknown"),
    provider: item.provider || "safepay",
    providerTracker: item.providerTracker || "",
    createdAt: item.createdAt || "",
    paidAt: item.paidAt || "",
    error: item.error || "",
  };
}

function publicUsage(item = {}) {
  return {
    id: item.id || "",
    workspaceId: item.workspaceId || "",
    feature: item.feature || "",
    unit: item.unit || "",
    quantity: creditNumber(item.quantity),
    creditsPerUnit: creditNumber(item.creditsPerUnit),
    credits: creditNumber(item.credits),
    createdAt: item.createdAt || "",
    metadata: item.metadata || {},
  };
}

function sanitizeMetadata(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return {};
  const output = {};
  for (const [key, raw] of Object.entries(value).slice(0, 30)) {
    const safeKey = clean(key).slice(0, 80);
    if (!safeKey) continue;
    if (raw == null || ["string", "number", "boolean"].includes(typeof raw)) {
      output[safeKey] = typeof raw === "string" ? raw.slice(0, 1000) : raw;
    }
  }
  return output;
}

function positiveNumber(value, fallback) {
  const number = Number(value);
  return Number.isFinite(number) && number >= 0 ? number : fallback;
}

function uniqueNumbers(values = []) {
  return [...new Set(values.map((value) => wholeCredits(value)).filter(Boolean))];
}

function wholeCredits(value) {
  const number = Number(value || 0);
  return Number.isFinite(number) ? Math.max(0, Math.floor(number)) : 0;
}

function creditNumber(value) {
  const number = Number(value || 0);
  return Number.isFinite(number) ? roundCredits(number) : 0;
}

function roundCredits(value) {
  return Math.round(Number(value || 0) * 1000) / 1000;
}

function byNewest(left, right) {
  return String(right.createdAt || right.updatedAt || "").localeCompare(
    String(left.createdAt || left.updatedAt || "")
  );
}

function clean(value) {
  return String(value ?? "").replace(/\s+/g, " ").trim();
}

function normalizeStatus(value) {
  return String(value || "").trim().toLowerCase().replace(/[\s-]+/g, "_");
}

function httpError(statusCode, message, code = "", details = null) {
  const error = new Error(message);
  error.statusCode = statusCode;
  if (code) error.code = code;
  if (details) error.details = details;
  return error;
}

export const CREDIT_BILLING_DEFAULTS = {
